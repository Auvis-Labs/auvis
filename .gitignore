# ==========================================
# AUVIS Workspace Gitignore Configuration
# ==========================================

# OS Metadata
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# IDEs and Editors
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ------------------------------------------
# 1. Audit Logs (JSONL files)
# ------------------------------------------
# Ignore unstructured/append-only JSONL files created during testing or execution
*.jsonl
audit.jsonl
**/audit.jsonl
auvis-infra/audit.jsonl
audit.jsonl.*

# ------------------------------------------
# 2. Local Environment Configuration
# ------------------------------------------
# Ignore all dot-env files and local configuration overrides
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local.yaml
*local.yaml
*.local.yml
*local.yml
auvis-infra/auvis.local.yaml
.continue/
.continue
# ------------------------------------------
# 3. Compiled Binaries and Go Artifacts
# ------------------------------------------
# Compiled Go binaries and test runners
/auvis-infra/auvis-infra
/auvis-infra/auvis
/auvis
dist/
build/
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.prof
*.out
cover.out

# ------------------------------------------
# 4. Python Environment & Cache (test-server)
# ------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Pytest / coverage
.cache/
.pytest_cache/
.coverage
.coverage.*
.htmlcov/
nosetests.xml
coverage.xml
*.cover
*.log

# Virtual Environments
.venv/
venv/
ENV/
env/
python-venv/

# Agents
.continue/

opensource_prep.md

docs/*