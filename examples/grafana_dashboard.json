      "id": 1,
      "title": "Proxy Request Throughput",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(auvis_requests_total[1m]))",
          "legendFormat": "Req/sec",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "displayMode": "color-background"
          },
          "unit": "reqps"
        }
      }
